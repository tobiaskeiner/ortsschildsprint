{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ortsschildsprint-api",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-04-23",
  "triggers": {
    // Every minute: each scheduled invocation receives its own subrequest
    // budget, so import batches and webhook retries progress continuously
    // and a backlog drains at the pace Strava's rate limits allow instead of
    // the pace of the schedule. The batches pace themselves against the
    // usage Strava reports with every response.
    "crons": ["* * * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "vars": {
    "STRAVA_CLIENT_ID": "294829",
    "STRAVA_REDIRECT_URI": "https://ortsschildsprint.com/api/strava/callback",
  },
}
