{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ortsschildsprint-api",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-04-23",
  "triggers": {
    // Every 5 minutes so import batches and webhook retries progress
    // continuously instead of draining one batch per hour.
    "crons": ["*/5 * * * *"],
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
