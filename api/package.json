{
  "name": "api",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "test": "wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "refresh:city-limit-signs": "node --env-file=.env scripts/refresh-city-limit-signs.mjs",
    "strava:webhook": "node --env-file=.env scripts/strava-webhook-subscription.mjs",
    "lint": "pnpm exec eslint src",
    "prettier:check": "pnpm exec prettier . --check",
    "prettier": "pnpm exec prettier . --write",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@supabase/supabase-js": "2.119.2",
    "hono": "4.13.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "wrangler": "4.166.0"
  }
}
